{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "test/**", "scripts/**", "*.json", "!bun.lock"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 130 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "off" },
      "suspicious": { "noExplicitAny": "warn" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
