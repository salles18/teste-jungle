# --- copy to .env (Bun loads it automatically). No real secrets here. ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# INSTANCE_ID=local-1          # defaults to <hostname>-<pid>; used as outbox lease owner

# PostgreSQL (docker compose)
DATABASE_URL=postgresql://jungle:jungle@localhost:5432/jungle_wallet
TEST_DATABASE_URL=postgresql://jungle:jungle@localhost:5432/jungle_wallet_test
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
TX_RETRY_MAX_ATTEMPTS=5

SUPPORTED_CURRENCIES=BRL

# SQS (LocalStack). Dummy credentials: LocalStack accepts anything.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_REDRIVE_MAX_RECEIVE_COUNT=10
SQS_MAX_ATTEMPTS=5
SQS_BASE_BACKOFF_MS=1000
SQS_MAX_BACKOFF_MS=60000

# Roles of this process
RUN_HTTP=true
RUN_SQS_CONSUMER=true
RUN_OUTBOX_PUBLISHER=true
RUN_PENDING_REFERENCE_WORKER=true

# Outbox publisher
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=20

# Out-of-order references
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=300000
PENDING_REFERENCE_TTL_MS=3600000
