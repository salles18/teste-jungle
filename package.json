{
  "name": "jungle-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "Wallet & wagering ledger service (Jungle Gaming technical challenge)",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.1",
  "scripts": {
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "db:migrate": "bun run src/infrastructure/database/migration-cli.ts up",
    "db:rollback": "bun run src/infrastructure/database/migration-cli.ts down",
    "db:fresh": "bun run src/infrastructure/database/migration-cli.ts fresh",
    "db:status": "bun run src/infrastructure/database/migration-cli.ts status",
    "queues:setup": "bun run scripts/setup-queues.ts",
    "setup": "bun run infra:up && bun run db:migrate && bun run queues:setup",
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "seed": "bun run scripts/seed.ts",
    "demo:concurrency": "bun run scripts/demo-concurrency.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:required": "REQUIRE_SQS=1 bun run test",
    "validate": "bun run scripts/validate-delivery.ts",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 180000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1144.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "decimal.js": "10.6.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  }
}
